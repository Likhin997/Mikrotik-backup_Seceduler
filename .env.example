# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- KEAMANAN & ANTI-SHODAN (Untuk Deployment Docker / VPS) ---
# Bind hanya ke localhost (127.0.0.1) agar port tidak terdeteksi Shodan/Censys/ZoomEye
BIND_IP="127.0.0.1"
HOST_PORT="3003"

# Set "true" jika aplikasi berada di belakang Nginx / Caddy / Cloudflare Tunnel
TRUST_PROXY="false"

# Opsional: Whitelist IP / CIDR (pisahkan dengan koma). Jika diisi, IP di luar daftar akan langsung di-drop
# Contoh: ALLOWED_IPS="127.0.0.1,::1,192.168.0.0/16,10.0.0.0/8,100.64.0.0/10"
ALLOWED_IPS=""

# Blokir otomatis scanner publik (Shodan, Censys, ZoomEye, Masscan, Nmap, dll)
BLOCK_SCANNERS="true"

# Tutup koneksi diam-diam (silent drop) tanpa banner HTTP bagi scanner / IP ilegal
STEALTH_DROP="true"

# Opsional: Token Cloudflare Tunnel untuk akses aman tanpa membuka port publik apapun
CLOUDFLARE_TUNNEL_TOKEN=""
